{
  "name": "skrivebord",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @skrivebord/web dev",
    "build": "pnpm --filter @skrivebord/web build",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.5.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.3",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
